# Production environment for the GCP single-VM deployment.
# Copy to .env on the VM, fill in secrets, then `make deploy`.
# NEVER commit a populated .env (see .gitignore / NFR-11).
# See docs/adr/0009-gcp-single-vm-demo-deployment.md and infra/gcp/README.md.

# --- Public hostname ---
# The domain pointed at the VM. Caddy auto-provisions a Let's Encrypt cert.
# For a local prod-stack smoke test, set this to ":80" (bare port = plain HTTP, no TLS).
DEPLOY_HOSTNAME=your.domain.example

# --- Database (PostGIS) ---
# Generate strong passwords: `openssl rand -base64 24`.
POSTGRES_USER=terrabean
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=terrabean
DATABASE_URL=postgresql+psycopg://terrabean:REPLACE_WITH_STRONG_PASSWORD@postgis:5432/terrabean

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (object storage for COGs) ---
MINIO_ROOT_USER=terrabean
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=terrabean-cogs

# --- Suitability model config (NFR-14) ---
SUITABILITY_CONFIG_PATH=/config/suitability/arabica-2026.1.yaml

# --- Auth ---
# MUST stay false in prod until Phase 4 SSO lands. If true, the api skips auth entirely.
DEV_AUTH_BYPASS=true

# --- Frontend / API routing (single-origin behind Caddy) ---
# Browser hits one origin; the backend hands out relative URLs.
VITE_API_BASE=/api
TITILER_BASE_URL=/tiles
CORS_ORIGINS=["https://your.domain.example"]
