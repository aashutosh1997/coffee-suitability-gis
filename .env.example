# Copy to .env and fill local secrets. NEVER commit .env (see .gitignore / NFR-11).

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=terrabean
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=terrabean
# Hostname "postgis" is the compose service name; use localhost when running outside compose.
DATABASE_URL=postgresql+psycopg://terrabean:change-me-locally@postgis:5432/terrabean

# --- Redis (Celery broker + result cache) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage for COGs) ---
MINIO_ROOT_USER=terrabean
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=terrabean-cogs

# --- Suitability model config (NFR-14: version-controlled, not hard-coded) ---
SUITABILITY_CONFIG_PATH=/config/suitability/arabica-2026.1.yaml

# --- Auth ---
# Phase 0 runs without Keycloak; bypass auth locally. MUST be false once SSO lands (Phase 4).
DEV_AUTH_BYPASS=true

# --- Frontend ---
VITE_API_BASE=http://localhost:8000

# --- TiTiler (raster overlay tile server, FR-13) ---
# The backend joins this with /cog/tiles/... to give the browser ready-to-fetch URLs.
# Production: api and titiler share a single nginx origin so this becomes a path.
TITILER_BASE_URL=http://localhost:8001
